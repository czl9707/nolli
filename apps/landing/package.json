    "@nolli/ui": "workspace:*",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "postcss": "^8",
    "postcss-custom-media": "^12.0.1",
    "postcss-custom-properties": "^15.0.1",
    "tsx": "^4.23.0",
