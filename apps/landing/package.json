{
  "name": "landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run bake && vite",
    "build": "pnpm run generate:patterns && pnpm run bake && vite build",
    "generate:patterns": "tsx --tsconfig tsconfig.json ../../packages/map/scripts/generate-patterns.ts",
    "bake": "tsx scripts/bake-landing-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@nolli/map": "workspace:*",
    "@nolli/ui": "workspace:*",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.30.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "postcss": "^8",
    "postcss-custom-media": "^12.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
